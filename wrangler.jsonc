{
  // Cloudflare Worker for sabres.studio: serves the site from public/ and sends
  // rehearsal requests by email (worker.js).
  "name": "sabres-studio",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": {
    "SITE_ORIGIN": "https://sabres.studio",
    "MAIL_TO": "beno842003@gmail.com",
    "MAIL_CC": "amitzil03@gmail.com",
    // Must be an address on a domain verified in Resend (sabres.studio).
    "MAIL_FROM": "אולפני סברס <bookings@sabres.studio>"
  },
  // Secret, set once with: npx wrangler@4 secret put RESEND_API_KEY
  "routes": [
    { "pattern": "sabres.studio", "custom_domain": true },
    { "pattern": "www.sabres.studio", "custom_domain": true }
  ]
}
